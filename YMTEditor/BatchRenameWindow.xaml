<Window x:Class="YMTEditor.BatchRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YMTEditor"
        mc:Ignorable="d"
        Title="Batch rename" Height="660" Width="900" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- folder -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="folderBox" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Pick folder..." Margin="8,0,0,0" Click="PickFolder_Click" />
        </Grid>

        <!-- rules -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                Background="#FF1E293B" BorderBrush="#FF263449" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Everything ticked is applied, in this order." Foreground="#FF94A3B8" Margin="0,0,0,8" />

                <!-- ped name -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Name="pedNameCheck" Content="Rename the ped" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Renames name^..., name_p^..., name.ymt and name.yft in one go" />
                    <ComboBox Grid.Column="1" Name="pedNameFrom" IsEditable="True" Height="26"
                              SelectionChanged="Option_Changed" />
                    <TextBlock Grid.Column="2" Text="  to  " VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Name="pedNameTo" TextChanged="Option_Changed" />
                </Grid>

                <!-- component slot -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Name="slotCheck" Content="Move component" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="jbib_004_u.ydd becomes task_004_u.ydd, textures included" />
                    <ComboBox Grid.Column="1" Name="slotFrom" Height="26" SelectionChanged="Option_Changed" />
                    <TextBlock Grid.Column="2" Text="  to  " VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" Name="slotTo" Height="26" SelectionChanged="Option_Changed" />
                </Grid>

                <!-- numbers -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Name="numberCheck" Content="Shift numbers by" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Moves drawable numbers, e.g. +5 turns 004 into 009 - useful before merging two peds" />
                    <TextBox Grid.Column="1" Name="numberOffset" Text="0" TextChanged="Option_Changed" />
                    <TextBlock Grid.Column="2" Text="  in slot  " VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" Name="numberSlot" Height="26" SelectionChanged="Option_Changed" />
                </Grid>

                <!-- replace -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Name="replaceCheck" Content="Replace text" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <TextBox Grid.Column="1" Name="replaceFind" TextChanged="Option_Changed" />
                    <TextBlock Grid.Column="2" Text="  with  " VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Name="replaceWith" TextChanged="Option_Changed" />
                </Grid>

                <!-- remove -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Name="removeCheck" Content="Remove text" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <TextBox Grid.Column="1" Name="removeText" TextChanged="Option_Changed" />
                </Grid>

                <!-- add -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Name="addCheck" Content="Add at start / end" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="The end part goes before the extension" />
                    <TextBox Grid.Column="1" Name="addPrefix" TextChanged="Option_Changed" />
                    <TextBlock Grid.Column="2" Text="  name  " VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Name="addSuffix" TextChanged="Option_Changed" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Name="lowerCheck" Content="lower case" Margin="0,0,20,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox Name="clothingOnlyCheck" Content="Only .ydd / .ytd / .yld" Margin="0,0,20,0"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Off: .ymt, .yft and .meta are renamed too, which is what you want when renaming a ped" />
                    <CheckBox Name="recursiveCheck" Content="Include sub-folders" IsChecked="True"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- preview -->
        <ListBox Grid.Row="2" Name="previewList" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12" />

        <TextBlock Grid.Row="3" Name="status" Margin="2,8,0,0" Foreground="#FF94A3B8" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="90" Height="28" Margin="0,0,8,0" Content="Close" IsCancel="True" Click="Close_Click" />
            <Button Width="150" Height="28" Name="applyButton" Content="Rename the files"
                    IsDefault="True" IsEnabled="False" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
